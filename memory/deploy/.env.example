# 复制为 deploy/.env 后填写，不要提交到 git

# 访问令牌：用一个足够长的随机串
#   生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KB_TOKEN=

# 域名，Caddy 会为它自动申请证书；本地测试留 localhost
KB_DOMAIN=kb.example.com

# 设为 1 则云端只读，写入只允许本地（适合把云端当"公开查阅"场景）
KB_READONLY=0

# 允许的跨域来源，默认 *；收紧时填具体的 MCP 客户端域名
KB_CORS_ORIGIN=*
